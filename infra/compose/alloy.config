// Grafana Alloy — log shipping (replaces Promtail)

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

local.file_match "arbor_logs" {
  path_targets = [{
    __path__ = "/var/log/arbor/*.log",
    job      = "arbor",
    service  = "arbor-api",
  }]
}

loki.source.file "arbor" {
  targets    = local.file_match.arbor_logs.targets
  forward_to = [loki.write.default.receiver]
}
