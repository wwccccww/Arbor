DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner
# Real retrieval (bge-m3). SiliconFlow is the default OpenAI-compatible host.
# https://cloud.siliconflow.cn
EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3
# Optional separate judge for RAGAS faithfulness. Must differ from the generator key.
# Omit ARBOR_JUDGE_API_KEY to reuse EMBEDDING_API_KEY / SILICONFLOW_API_KEY when DEEPSEEK is generator.
# SiliconFlow (OpenAI-compatible) example — same account as EMBEDDING is OK if DEEPSEEK is generator:
# ARBOR_JUDGE_API_KEY=sk-你的SiliconFlow密钥
# ARBOR_JUDGE_BASE_URL=https://api.siliconflow.cn/v1
# ARBOR_JUDGE_MODEL=Qwen/Qwen2.5-14B-Instruct
# ARBOR_JUDGE_EMBEDDING_MODEL=BAAI/bge-m3
ARBOR_JUDGE_API_KEY=
# ARBOR_JUDGE_BASE_URL=https://api.siliconflow.cn/v1
# ARBOR_JUDGE_MODEL=Qwen/Qwen2.5-14B-Instruct
# ARBOR_JUDGE_EMBEDDING_MODEL=BAAI/bge-m3
# Optional persistence. Leave commented to use in-memory (demo).
# docker compose -f infra/compose/postgres.yml up -d
# DATABASE_URL=postgresql://arbor:arbor@127.0.0.1:5432/arbor
# Optional local data directory (uploads / attachments). Default: .arbor-data in repo root.
# ARBOR_DATA_DIR=/var/lib/arbor
# Object storage backend: local (disk), postgres (object_blobs table), or s3 (MinIO/AWS).
# ARBOR_OBJECT_STORE=local
# S3 / MinIO (pip install -e ".[s3]" and docker compose -f infra/compose/minio.yml up -d):
# ARBOR_OBJECT_STORE=s3
# ARBOR_S3_ENDPOINT=http://127.0.0.1:9000
# ARBOR_S3_BUCKET=arbor
# ARBOR_S3_ACCESS_KEY=arbor
# ARBOR_S3_SECRET_KEY=arbor-secret
# ARBOR_S3_PREFIX=arbor/
# Background jobs (import parsing). Default: sync inline when unset; redis when REDIS_URL set.
# docker compose -f infra/compose/redis.yml up -d
# REDIS_URL=redis://127.0.0.1:6379/0
# ARBOR_JOB_QUEUE=redis
# Run worker in a second terminal: arbor-worker
# Multimodal parsing (documents / speech). Install extras before import or chat attachments:
# python3 -m pip install -e ".[api,documents,speech,worker]"
# Documents: pypdf, python-docx, python-pptx (pdf/docx/pptx/md/txt)
# Speech: faster-whisper (mp3/wav/m4a → transcript Inbox)
# Images: uses DeepSeek chat API when DEEPSEEK_API_KEY set (image_caption Inbox)
# Document parser backend: light (pypdf/docx/pptx), docling, or auto (Docling when installed).
# ARBOR_DOCUMENT_PARSER=light
# Legacy .doc/.ppt: headless LibreOffice conversion (optional path to binary).
# ARBOR_LIBREOFFICE_PATH=/usr/bin/libreoffice
# Production hardening (disable static demo tokens; enforce tenant membership).
# ARBOR_DISABLE_DEMO_TOKENS=1
# ARBOR_STRICT_TENANT_MEMBERSHIP=1
# ARBOR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:8000
# Feishu calendar (optional). Create app at https://open.feishu.cn/app
# ARBOR_FEISHU_APP_ID=
# ARBOR_FEISHU_APP_SECRET=
# ARBOR_FEISHU_REDIRECT_URI=http://localhost:8000/v1/auth/feishu/callback
# ARBOR_CALENDAR_BACKEND=auto
# ARBOR_WEB_URL=http://localhost:5173
# Ticket HTTP API (optional)
# ARBOR_TICKET_API_URL=https://your-ticket-api.example.com/tickets
# ARBOR_TICKET_API_KEY=
# ARBOR_TICKET_BACKEND=auto
# Tool invocation: keywords | llm | both (default both)
# ARBOR_TOOL_MODE=both

# Retrieval orchestrator v2 (default strategy layered_tree). See docs/architecture.md §6
# ARBOR_RETRIEVAL_POOL_K=24
# ARBOR_RETRIEVAL_RERANK_K=6
# ARBOR_RETRIEVAL_PROMPT_K=5
# ARBOR_RETRIEVAL_EVENT_SEED_K=2
# ARBOR_RETRIEVAL_EVENT_EXPAND_DEPTH=2
# ARBOR_RETRIEVAL_EVENT_EXPAND_MAX=8
# ARBOR_RETRIEVAL_HYBRID=on
# ARBOR_RETRIEVAL_QUERY_PLAN=rules
# ARBOR_RETRIEVAL_MMR_LAMBDA=0.7
# ARBOR_RETRIEVAL_TYPE_WEIGHT_FACT=1.0
# ARBOR_RETRIEVAL_TYPE_WEIGHT_CHUNK=0.6
# ARBOR_CHUNK_MAX_CHARS=1200
# ARBOR_CHUNK_OVERLAP_CHARS=150

# Context engineering (ContextCompiler)
# ARBOR_CONTEXT_WINDOW_TOKENS=64000
# ARBOR_CONTEXT_MAX_OUTPUT_TOKENS=2048
# ARBOR_CONTEXT_RECENT_K=6
# ARBOR_CONTEXT_SYSTEM_OVERHEAD=600
